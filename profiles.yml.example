# Fichier de configuration des profils dbt
# Ce fichier doit être copié vers ~/.dbt/profiles.yml (JAMAIS dans le repo git)
#
# Bonne pratique "expert" : ne jamais écrire de secret en clair dans ce
# fichier. On utilise env_var() pour lire les valeurs depuis
# l'environnement (ici, alimenté par le .env du projet à la racine).
#
# Avant de lancer dbt :
#   set -a && source .env && set +a
#   dbt debug

dbt_labs:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | as_number }}"
      user: "{{ env_var('POSTGRES_USER') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      # Pas de valeur par defaut : une variable manquante doit faire
      # ECHOUER dbt, pas rediriger silencieusement deux developpeurs
      # vers le meme schema partage. Meme discipline que POSTGRES_USER.
      schema: "{{ env_var('POSTGRES_SCHEMA') }}"
      threads: 4
      keepalives_idle: 0

    prod:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | as_number }}"
      user: "{{ env_var('POSTGRES_USER') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      schema: "dbt_prod"
      threads: 8
      keepalives_idle: 0

# --- Autres adaptateurs (a titre d'exemple, voir bootcamp/00-setup) ---
