#   user: "{{ env_var('SNOWFLAKE_USER') }}"
#   password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
#   role: votre_role
#   database: VOTRE_DATABASE
#   warehouse: VOTRE_WAREHOUSE
#   schema: DBT_DEV
